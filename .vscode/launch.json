    "version": "0.2.0",    
    "configurations": [        
        {
            "name": "Python: API via uvicorn",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "api.api:app",
                "--host", "127.0.0.1",
                "--port", "8000",
                "--reload"
            ],
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/api"  // <--- Ensures app is in Python path
            },
            "justMyCode": true
        }
    ]
}
